{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "LLM requests / min",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(studynexs_ai_llm_requests_total[5m])) * 60",
          "legendFormat": "req/min"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqpm" } }
    },
    {
      "type": "stat",
      "title": "LLM error rate",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(studynexs_ai_llm_requests_total{status=\"error\"}[5m])) / sum(rate(studynexs_ai_llm_requests_total[5m]))",
          "legendFormat": "error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Fallback success / min",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(studynexs_ai_llm_fallback_success_total[5m])) * 60",
          "legendFormat": "fallback/min"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Output tokens / min",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(studynexs_ai_llm_tokens_out_total[5m])) * 60",
          "legendFormat": "tokens/min"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM requests by feature",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (feature) (rate(studynexs_ai_llm_requests_total{status!=\"error\"}[5m]))",
          "legendFormat": "{{feature}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "LLM requests by provider",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (provider) (rate(studynexs_ai_llm_requests_total[5m]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "LLM p95 latency by feature (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, feature) (rate(studynexs_ai_llm_latency_seconds_bucket[5m])))",
          "legendFormat": "{{feature}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Token throughput (in + out)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(studynexs_ai_llm_tokens_in_total[5m]))",
          "legendFormat": "tokens in/s"
        },
        {
          "expr": "sum(rate(studynexs_ai_llm_tokens_out_total[5m]))",
          "legendFormat": "tokens out/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate (FastAPI auto-instrumentation)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otel_http_server_duration_milliseconds_count[5m]))",
          "legendFormat": "http req/s"
        }
      ],
      "description": "Requires OTEL_ENABLED and otel-collector scrape job."
    },
    {
      "type": "timeseries",
      "title": "LLM errors by error_type",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (feature, provider) (rate(studynexs_ai_llm_requests_total{status=\"error\"}[5m]))",
          "legendFormat": "{{feature}} / {{provider}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["studynexs", "ai", "llm"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "StudyNexs AI Telemetry",
  "uid": "studynexs-ai",
  "version": 1
}
