{
  "meta": {
    "name": "school-management-system",
    "description": "FastAPI monolith (apps/api) + Next.js portals; multi-tenant by school. Parent/student/admin apps are planned conventions—paths may not exist until scaffolded.",
    "api_prefix_default": "/api/v1",
    "auth_pattern": "Bearer access JWT in memory + HttpOnly refresh cookie on API host (hybrid); see apps/api/app/modules/auth/cookie_util.py"
  },
  "nodes": [
    { "id": "root", "type": "repository", "label": "school-management-system" },
    { "id": "api", "type": "application", "path": "apps/api", "runtime": "FastAPI", "entry": "app/main.py", "status": "implemented" },
    { "id": "staff-web", "type": "application", "path": "apps/staff-web", "runtime": "Next.js", "entry": "src/app/layout.tsx", "primary_roles": ["teacher", "class_incharge", "admin", "super_admin", "operations"], "status": "implemented" },
    { "id": "parent-web", "type": "application", "path": "apps/parent-web", "runtime": "Next.js", "entry": "src/app/layout.tsx (planned)", "primary_roles": ["parent"], "status": "planned" },
    { "id": "student-web", "type": "application", "path": "apps/student-web", "runtime": "Next.js", "entry": "src/app/layout.tsx (planned)", "primary_roles": ["student"], "status": "planned" },
    { "id": "admin-web", "type": "application", "path": "apps/admin-web", "runtime": "Next.js", "entry": "src/app/layout.tsx (planned)", "primary_roles": ["admin", "super_admin"], "status": "planned" },
    { "id": "api-core", "type": "package", "path": "apps/api/app/core", "contains": ["config", "database", "dependencies", "security", "tenant", "logging"] },
    { "id": "api-db", "type": "package", "path": "apps/api/app/db/models", "role": "SQLAlchemy ORM" },
    { "id": "api-shared", "type": "package", "path": "apps/api/app/shared/schemas", "role": "SuccessResponse, ErrorResponse" },
    { "id": "worker-outbox", "type": "worker", "path": "apps/api/app/workers/outbox_worker.py", "status": "implemented" },
    { "id": "migrations", "type": "migrations", "path": "apps/api/alembic/versions" },
    { "id": "mod-auth", "type": "module", "path": "apps/api/app/modules/auth", "router_tag": "Authentication" },
    { "id": "mod-users", "type": "module", "path": "apps/api/app/modules/users" },
    { "id": "mod-academic", "type": "module", "path": "apps/api/app/modules/academic", "note": "classes, subjects, students, teachers, floors, phase5" },
    { "id": "mod-timetable", "type": "module", "path": "apps/api/app/modules/timetable" },
    { "id": "mod-examinations", "type": "module", "path": "apps/api/app/modules/examinations" },
    { "id": "mod-attendance", "type": "module", "path": "apps/api/app/modules/attendance" },
    { "id": "mod-fees", "type": "module", "path": "apps/api/app/modules/fees" },
    { "id": "mod-files", "type": "module", "path": "apps/api/app/modules/files" },
    { "id": "mod-ai", "type": "module", "path": "apps/api/app/modules/ai" },
    { "id": "mod-communications", "type": "module", "path": "apps/api/app/modules/communications" },
    { "id": "mod-notifications", "type": "module", "path": "apps/api/app/modules/notifications" },
    { "id": "mod-school_ops", "type": "module", "path": "apps/api/app/modules/school_ops" },
    { "id": "mod-analytics", "type": "module", "path": "apps/api/app/modules/analytics" }
  ],
  "edges": [
    { "from": "staff-web", "to": "api", "relation": "rest_client", "via": "src/lib/api.ts", "base_url_env": "NEXT_PUBLIC_API_URL", "credentials": "include for refresh cookie path" },
    { "from": "parent-web", "to": "api", "relation": "rest_client", "via": "src/lib/api.ts (same pattern as staff-web)", "base_url_env": "NEXT_PUBLIC_API_URL", "note": "planned — mirror hybrid auth + tenant headers" },
    { "from": "student-web", "to": "api", "relation": "rest_client", "via": "src/lib/api.ts (same pattern)", "base_url_env": "NEXT_PUBLIC_API_URL", "note": "planned" },
    { "from": "admin-web", "to": "api", "relation": "rest_client", "via": "src/lib/api.ts (same pattern)", "base_url_env": "NEXT_PUBLIC_API_URL", "note": "planned — may share subset of staff routes or full admin surface" },
    { "from": "api", "to": "api-core", "relation": "imports" },
    { "from": "api", "to": "api-db", "relation": "orm" },
    { "from": "api", "to": "api-shared", "relation": "response_envelope" },
    { "from": "mod-auth", "to": "api-core", "relation": "uses", "details": "security, config, redis" },
    { "from": "mod-users", "to": "api-db", "relation": "uses" },
    { "from": "mod-academic", "to": "api-db", "relation": "uses" },
    { "from": "mod-fees", "to": "api-db", "relation": "uses" },
    { "from": "mod-fees", "to": "worker-outbox", "relation": "may_emit", "details": "OutboxEvent for cross-module hooks" },
    { "from": "worker-outbox", "to": "api-db", "relation": "reads_writes" },
    { "from": "migrations", "to": "api-db", "relation": "schema_source_of_truth" }
  ]
}
