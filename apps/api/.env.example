# StudyNexs API — Environment Template
# Copy to .env and fill in real values. NEVER commit .env (it is git-ignored).
ENVIRONMENT=development
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=studynexs
POSTGRES_PASSWORD=changeme
POSTGRES_DB=studynexs

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (production requires ≥32 chars; app refuses to boot otherwise)
JWT_SECRET_KEY=CHANGE-ME-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Tenant
TENANT_BASE_DOMAIN=studynexs.com
DEFAULT_TENANT_SLUG=dev

# Webhook
WEBHOOK_SECRET=change-me

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# AI / LLM Gateway (provider key must match AI_DEFAULT_PROVIDER; prod boot fails if missing)
AI_DEFAULT_MODEL=
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
