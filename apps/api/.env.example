# StudyNexs API — Environment Template
# Copy to .env and fill in real values. NEVER commit .env (it is git-ignored).
ENVIRONMENT=development
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=studynexs
POSTGRES_PASSWORD=changeme
POSTGRES_DB=studynexs

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (production requires ≥32 chars; app refuses to boot otherwise)
JWT_SECRET_KEY=CHANGE-ME-to-a-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Tenant
TENANT_BASE_DOMAIN=studynexs.com
DEFAULT_TENANT_SLUG=dev

# Webhook
WEBHOOK_SECRET=change-me

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Optional: Tesseract OCR for admission document number detection (image scans).
# Install Tesseract, then set this on Windows if it is not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# AI / LLM Gateway (provider key must match AI_DEFAULT_PROVIDER; prod boot fails if missing)
AI_DEFAULT_MODEL=
AI_DEFAULT_PROVIDER=openai
AI_FALLBACK_PROVIDER=ollama
OPENAI_API_KEY=sk-your-key-here

# Ollama fallback — gemma4:cloud via local Ollama (run: ollama pull gemma4:cloud)
# From Docker on Windows/Mac use host.docker.internal to reach Ollama on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:cloud
OLLAMA_API_KEY=

# OpenTelemetry — enable with observability Docker stack (infra/observability/README.md)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=studynexs-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLE_RATE=1.0

# Azure Speech — soft female Indian Neural TTS for the AI tutor.
# Leave AZURE_SPEECH_KEY empty to fall back to the browser's Web Speech voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
AZURE_SPEECH_VOICE=en-IN-NeerjaNeural
