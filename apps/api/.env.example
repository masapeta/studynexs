# StudyNexs API — local development environment template
#
# Copy to .env and adjust. Every value here is a safe, non-production default.
# The full typed reference (all ~120 settings with defaults) is
# app/core/config.py — only the values a developer commonly touches are
# listed. Production values come from the deployment secret store, never
# from a committed file; the boot guardrail rejects these dev defaults in
# production.

# --- Core -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- Database (matches infra/docker/docker-compose.dev.yml) -----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=studynexs
POSTGRES_PASSWORD=studynexs_dev
POSTGRES_DB=studynexs

# --- Redis -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Auth --------------------------------------------------------------
# Dev-only value; production requires a real >=32-char secret or boot fails.
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION-32-chars-minimum

# --- Tenancy -----------------------------------------------------------
TENANT_BASE_DOMAIN=localhost
DEFAULT_TENANT_SLUG=dev

# --- Vector store (Qdrant, from the dev compose) ------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- AI providers (optional — features degrade gracefully without keys) --
# GEMINI_API_KEY=<from-secret-store>
# OPENAI_API_KEY=<from-secret-store>
# ANTHROPIC_API_KEY=<from-secret-store>
AI_DEFAULT_PROVIDER=gemini
# Local fallback via Ollama (optional):
# AI_FALLBACK_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# --- File storage / OCR (optional) ---------------------------------------
# AZURE_STORAGE_CONNECTION_STRING=<from-secret-store>
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Observability (optional) --------------------------------------------
# METRICS_TOKEN=<any-local-token-to-expose-/metrics>
# OTEL_ENABLED=false

# --- Tutor voice (works with no key: edge = Microsoft Neerja) -------------
TUTOR_TTS_PROVIDER=edge
